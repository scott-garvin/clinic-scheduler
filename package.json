{
  "name": "clinic-scheduler",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Clera — a patient scheduling / appointment tracker demo (Vue 3 + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "dev:api": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs",
    "start": "node build/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@lucide/vue": "^1.47.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "vue": "^3.5.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
