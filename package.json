{
  "name": "clinic-scheduler",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Clera — a patient scheduling / appointment tracker demo (Vue 3 + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "dev:api": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs",
    "start": "node build/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mcp": "tsx mcp/index.ts",
    "mcp:demo": "tsx mcp/demo.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@lucide/vue": "^1.69.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
